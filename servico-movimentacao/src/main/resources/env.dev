spring.config.import=optional:classpath:env.dev[.properties]

spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/movimentacao_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC}
spring.datasource.username=${DB_USERNAME:movimentacao_dev}
spring.datasource.password=${DB_PASSWORD:movimentacao_dev}

spring.jpa.hibernate.ddl-auto=${JPA_DDL_AUTO:none}
spring.jpa.show-sql=${JPA_SHOW_SQL:true}