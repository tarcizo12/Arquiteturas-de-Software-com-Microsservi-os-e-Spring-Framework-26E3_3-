# ============================================================
# DESENVOLVIMENTO - aplicacao-principal
# Banco: container estoque-mysql-dev (porta 3306)
# ============================================================
SERVER_PORT=8080

DB_URL=jdbc:mysql://localhost:3306/estoque_principal?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=estoque_dev
DB_PASSWORD=estoque_dev

JPA_DDL_AUTO=none
JPA_SHOW_SQL=true

SERVICO_COMUNICACAO_URL=http://localhost:8081
FEIGN_CONNECT_TIMEOUT=2000
FEIGN_READ_TIMEOUT=3000
